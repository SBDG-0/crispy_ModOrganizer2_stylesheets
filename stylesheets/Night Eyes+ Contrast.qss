/* Night Eyes theme v1.2.0 for Mod Organizer 2 by Ciathyza */
/* https://github.com/ciathyza/mo2-themes */
/* Main Window ---------------------------------------------------------------- */
QWidget { background: #181818; color: #E2E2E2; }
QWidget:disabled { background: #181818; color: #959595; }
QMainWindow::separator { border: 0px; }
QAbstractItemView { background: #141414; alternate-background-color: #141414; show-decoration-selected: 1; selection-background-color: #001133; selection-color: #FFFFFF; }
QAbstractItemView::item:hover { color: #FFFFFF; }
QAbstractItemView::item:selected { background: #001133; color: #FFFFFF; }
QAbstractScrollArea::corner { background: #141414; border: 2px solid #181818; border-bottom-right-radius: 6px; margin: 0px -2px -2px 0px; }
LinkLabel { qproperty-linkColor: #78B8FF; }
/* Toolbar -------------------------------------------------------------------- */
QToolBar { background: #181818; border: 1px solid #181818; }
QToolBar::separator { background: #181818; }
QToolButton { padding: 4px 1px; border-radius: 2px; margin: 4px 1px 0px 1px; }
QToolButton:hover { background: #282828; }
QToolButton:pressed { background: #181818; }
QToolButton::menu-indicator { width: 8px; }
/* Left Pane & File Trees ----------------------------------------------------- */
QTreeView { border-radius: 6px; }
QTreeView::branch:hover { background: #181818; color: #FFFFFF; }
QTreeView::branch:selected { background: #001133; color: #FFFFFF; }
QTreeView::item:selected { background: #001133; color: #FFFFFF; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { image: url(:/stylesheet/branch-closed.png); border: 0px; }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { image: url(:/stylesheet/branch-open.png); border: 0px; }
QListView { border-radius: 6px; }
QListView::item:hover { background: #242424; color: #FFD59C; }
QListView::item:selected { background: #001133; color: #FFFFFF; }
QTextEdit { background: #141414; border-radius: 6px; }
QWebView { background: #141414; border-radius: 6px; }
/* Group Boxes ---------------------------------------------------------------- */
QGroupBox { padding: 24px 4px; border: 2px solid #141414; border-radius: 10px; }
QGroupBox::title { subcontrol-origin: padding; subcontrol-position: top left; padding: 8px; }
/* Search Boxes --------------------------------------------------------------- */
QLineEdit { background: #141414; min-height: 14px; padding: 2px; border: 2px solid #141414; border-radius: 6px; margin-top: 3px; }
QLineEdit:hover { border: 2px solid #242424; }
/* Most Dropdowns ------------------------------------------------------------- */
QComboBox { background: #141414; min-height: 20px; padding-left: 5px; border: 2px solid #141414; border-radius: 6px; margin: 3px 0px 1px 0px; }
QComboBox:hover { border: 2px solid #242424; }
QComboBox:on { background: #181818; color: #FFD59C; border: 2px solid #181818; }
QComboBox::drop-down { width: 20px; subcontrol-origin: padding; subcontrol-position: top right; border: none; }
QComboBox QAbstractItemView { border: 0px; }
QComboBox::down-arrow { image: url(:/stylesheet/combobox-down.png); }
/* Most Buttons --------------------------------------------------------------- */
QPushButton { background: #141414; color: #FFD59C; min-height: 18px; padding: 2px 12px; border-radius: 6px; }
QPushButton:hover { background: #242424; color: #FFD59C; }
QPushButton:pressed { background: #181818; color: #FFD59C; }
QPushButton:checked { background: #181818; color: #FFD59C; margin: 4px; }
/* Scroll Bars ---------------------------------------------------------------- */
/* Horizontal */
QScrollBar:horizontal { background: #141414; height: 16px; border: 2px solid #181818; margin: 0px 23px -2px 23px; }
QScrollBar::handle:horizontal { background: #222222; min-width: 32px; border-radius: 6px; margin: 2px; }
QScrollBar::add-line:horizontal { background: #141414; width: 23px; subcontrol-position: right; subcontrol-origin: margin; border: 2px solid #181818; margin: 0px -2px -2px 0px; }
QScrollBar::sub-line:horizontal { background: #141414; width: 23px; subcontrol-position: left; subcontrol-origin: margin; border: 2px solid #181818; border-bottom-left-radius: 6px; margin: 0px 0px -2px -2px; }
/* Vertical */
QScrollBar:vertical { background: #141414; width: 16px; border: 2px solid #181818; margin: 23px -2px 23px 0px; }
QScrollBar::handle:vertical { background: #222222; min-height: 32px; border-radius: 6px; margin: 2px; }
QScrollBar::add-line:vertical { background: #141414; height: 23px; subcontrol-position: bottom; subcontrol-origin: margin; border: 2px solid #181818; border-bottom-right-radius: 6px; margin: 0px -2px -2px 0px; }
QScrollBar::sub-line:vertical { background: #141414; height: 23px; subcontrol-position: top; subcontrol-origin: margin; border: 2px solid #181818; border-top-right-radius: 6px; margin: -2px -2px 0px 0px; }
/* Combined */
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover, QScrollBar::add-line:horizontal:hover, QScrollBar::sub-line:horizontal:hover, QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover { background: #242424; }
QScrollBar::handle:horizontal:pressed, QScrollBar::handle:vertical:pressed, QScrollBar::add-line:horizontal:pressed, QScrollBar::sub-line:horizontal:pressed, QScrollBar::add-line:vertical:pressed, QScrollBar::sub-line:vertical:pressed { background: #181818; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar::up-arrow:vertical, QScrollBar::right-arrow:horizontal, QScrollBar::down-arrow:vertical, QScrollBar::left-arrow:horizontal { height: 1px; width: 1px; border: 1px solid #181818; }
/* Header Rows ---------------------------------------------------------------- */
QHeaderView { background: #181818; }
/* Table View Tab Headers */
QHeaderView::section { background: #141414; color: #E2E2E2; height: 22px; padding: 0px 5px; border: 0px; border-bottom: 2px solid #181818; border-right: 2px solid #181818; }
QHeaderView::section:first { border-top-left-radius: 6px; }
QHeaderView::section:last { border-right: 0px; border-top-right-radius: 6px; }
QHeaderView::section:hover { background: #242424; color: #FFD59C; }
QHeaderView::down-arrow { padding-right: 4px; height: 10px; width: 10px; }
/* Context Menus, Toolbar Dropdowns, & Tooltips ------------------------------- */
QMenuBar { background: #181818; border: 1px solid #181818; }
QMenuBar::item:selected { background: #242424; color: #FFD59C; }
QMenu { background: #141414; selection-color: #FFD59C; border: 0px; }
QMenu::item { background: #141414; selection-background-color: #242424; padding: 4px 20px; }
QMenu::item:selected { background: #242424; color: #FFD59C; }
QMenu::item:disabled { background: #242424; color: #959595; }
QMenu::separator { background: #181818; height: 2px; }
QMenu::icon { margin: 1px; }
QToolTip { background: #181818; color: #FFD59C; padding: 1px; border: 0px; }
QStatusBar::item { border: None; }
/* Progress Bars (Downloads) -------------------------------------------------- */
QProgressBar { background: #141414; text-align: center; border: 0px; border-radius: 6px; margin: 0px 10px; }
QProgressBar::chunk { background: #242424; border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
/* Right Pane and Tab Bars ---------------------------------------------------- */
QTabWidget::pane { top: 1px; padding: 2px 2px 10px 2px; border: 2px solid #141414; border-radius: 10px; }
QTabWidget::tab-bar { alignment: center; }
QTabBar::tab { background: #141414; color: #141414; padding: 4px 1em; border: 1px solid #181818; border-top: 0px; border-bottom: 0px; }
QTabBar::tab:!selected { background: #141414; color: #E2E2E2; }
QTabBar::tab:disabled { background: #181818; color: #959595; }
QTabBar::tab:selected { background: #181818; color: #FFD59C; }
QTabBar::tab:!selected:hover { background: #242424; color: #FFD59C; }
QTabBar::tab:first { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QTabBar::tab:last { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QTabBar QToolButton { background: #242424; padding: 1px; border-radius: 6px; margin: 1px; }
QTabBar QToolButton:disabled { background: transparent; }
/* Sliders (Configurator) ----------------------------------------------------- */
/* QSlider::groove:horizontal
{
	background: #FFCC88;
	height: 1px;
	border: 1px solid #FFCC88;
}

QSlider::handle:horizontal
{
	background: #242424;
	width: 10px;
	border: 2px solid #242424;
	border-radius: 6px;
	margin: -10px 0px;
}

QSlider::handle:horizontal:hover
{
	background: #181818;
	border: 2px solid #181818;
} */
/* Tables (Configure Mod Categories) ------------------------------------------ */
QTableView { gridline-color: #181818; border: 0px; }
QListWidget::item#executablesListBox { /* fixes the black text problem on the Modify Executables window */ color: #E2E2E2; }
/* Downloads tab -------------------------------------------------------------- */
QWidget#downloadTab QAbstractScrollArea { /* background of the entire downloads tab */ background: #141414; }
DownloadListView QFrame { /* an entry on the Downloads tab */ background: #181818; }
DownloadListView QFrame#frame { /* outer box of an entry on the Downloads tab */ border: 2px solid #141414; }
DownloadListView QLabel#installLabel { color: none; }
DownloadListView QFrame:clicked { background: #242424; }
/* compact downloads view */
DownloadListView[downloadView=standard]::item { padding: 16px; }
DownloadListView[downloadView=compact]::item { padding: 4px; }
DownloadListView::item:hover { padding: 0px; }
DownloadListView::item:selected { padding: 0px; }
QProgressBar { border: 2px solid grey; border-radius: 5px; text-align: center; margin: 0px; }
QAbstractItemView[filtered=true] { border: 2px solid #f00; }
QLineEdit[valid-filter=false] { background-color: #661111; }
/* Contrast variant of Night Eyes v1.2.0 by Ciathyza.
   Original #181818 / #141414 surfaces, geometry and icons retained.
   Only foregrounds, interaction highlights and focus borders adjusted. */
QWidget { selection-background-color: #264B73; selection-color: #FFFFFF; }
QAbstractItemView, QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox { selection-background-color: #264B73; selection-color: #FFFFFF; }
QAbstractItemView::item:hover, QTreeView::item:hover, QListView::item:hover { background: #242424; color: #FFFFFF; }
QAbstractItemView::item:selected, QAbstractItemView::item:selected:hover, QAbstractItemView::item:selected:!active, QAbstractItemView::item:alternate:selected, QAbstractItemView::item:alternate:selected:hover, QTreeView::item:selected, QTreeView::item:selected:hover, QTreeView::item:selected:!active, QListView::item:selected, QListView::item:selected:hover, QListView::item:selected:!active, QTreeView::branch:selected, QTreeView::branch:selected:hover, QTreeView::branch:selected:!active { background: #264B73; color: #FFFFFF; }
QComboBox QAbstractItemView { selection-background-color: #264B73; selection-color: #FFFFFF; }
QTabBar::tab { color: #E2E2E2; }
QTabBar::tab:selected, QTabBar::tab:selected:hover { background: #264B73; color: #FFFFFF; }
QTabBar::tab:!selected:hover { color: #FFFFFF; }
QTabBar::tab:disabled { background: #181818; color: #959595; }
QMenu::item:selected, QMenuBar::item:selected { background: #264B73; color: #FFFFFF; }
QMenu::item:disabled { color: #959595; }
QPushButton:pressed, QPushButton:checked, QToolButton:pressed, QToolButton:checked { background: #264B73; color: #FFFFFF; }
QLineEdit:focus, QComboBox:focus, QComboBox:on { border-color: #78B8FF; }
QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled, QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { color: #959595; }
QAbstractItemView::item:selected:disabled, QTreeView::item:selected:disabled, QListView::item:selected:disabled { background: #242424; color: #959595; }
QListWidget::item#executablesListBox:selected { color: #FFFFFF; }
QProgressBar { color: #E2E2E2; }
QLineEdit[valid-filter="false"] { background-color: #661111; color: #FFFFFF; }
/* Centered menu icon gutter: preserve text padding and submenu arrows. */
QMenu::icon { position: relative; left: 11px; }
QMenu::indicator { position: relative; left: 12px; }
/* Keyboard focus uses an outline; persistent fills belong to hover, press and checked states. */
QPushButton:focus, QToolButton:focus { border-color: #78B8FF; }
/* Fix Mod Exists (reinstall) dialog layout */
QDialog#QueryOverwriteDialog { min-width: 565px; }
QDialog#QueryOverwriteDialog QPushButton { margin-left: 0.5em; }
QDialog QPushButton { min-width: 1.5em; }


/* Fluent Regular: pale icons for dark themes.
   Copy any complete section below AFTER your base theme.
   Keep mo2-icon-test-assets beside the destination stylesheet.
   Icon-only overrides; toolbar selectors must remain unscoped. */
/* ==================== Toolbar ==================== */
/* Change game / instance */
QToolButton#actionChange_Game { qproperty-icon: url("./res+/change_game.svg"); }
/* Install mod archive */
QToolButton#actionInstallMod { qproperty-icon: url("./res+/install_mod.svg"); }
/* Nexus / game mod page */
QToolButton#actionNexus, QToolButton#actionModPage { qproperty-icon: url("./res+/nexus_browser.svg"); }
/* Configure profiles */
QToolButton#actionAdd_Profile { qproperty-icon: url("./res+/profiles.svg"); }
/* Refresh MO2 */
QToolButton#action_Refresh { qproperty-icon: url("./res+/refresh_main.svg"); }
/* Modify executables */
QToolButton#actionModify_Executables { qproperty-icon: url("./res+/executables.svg"); }
/* Tool plugins */
QToolButton#actionTool { qproperty-icon: url("./res+/tools_menu.svg"); }
/* Settings */
QToolButton#actionSettings { qproperty-icon: url("./res+/settings.svg"); }
/* Endorse MO2 */
QToolButton#actionEndorseMO { qproperty-icon: url("./res+/endorse_mo.svg"); }
/* Notifications / problems */
QToolButton#actionNotifications { qproperty-icon: url("./res+/notifications.svg"); }
/* Check for updates */
QToolButton#actionUpdate { qproperty-icon: url("./res+/update_mo.svg"); }
/* Help / tutorials */
QToolButton#actionHelp { qproperty-icon: url("./res+/help_menu.svg"); }
/* ==================== Mod list ==================== */
/* List options */
#MainWindow QPushButton#listOptionsBtn { qproperty-icon: url("./res+/list_options.svg"); }
/* Open folders menu */
#MainWindow QPushButton#openFolderMenu { qproperty-icon: url("./res+/open_folder.svg"); }
/* Clear all filters */
#MainWindow QPushButton#clearFiltersButton { qproperty-icon: url("./res+/clear_filters.svg"); }
/* ==================== Mod / plugin lists ==================== */
/* Restore backup */
#MainWindow QPushButton#restoreModsButton, #MainWindow QPushButton#restoreButton { qproperty-icon: url("./res+/restore_backup.svg"); }
/* Create backup */
#MainWindow QPushButton#saveModsButton, #MainWindow QPushButton#saveButton { qproperty-icon: url("./res+/create_backup.svg"); }
/* ==================== Right pane ==================== */
/* Run executable */
#MainWindow QPushButton#startButton { qproperty-icon: url("./res+/run_start.svg"); }
/* Create shortcut */
#MainWindow QPushButton#linkButton { qproperty-icon: url("./res+/nexus_info_visit.svg"); }
/* ==================== Data / Downloads ==================== */
/* Refresh data / downloads */
#MainWindow QPushButton#dataTabRefresh, #MainWindow QPushButton#btnRefreshDownloads { qproperty-icon: url("./res+/refresh_data.svg"); }
/* ==================== Instance manager ==================== */
/* Create instance */
#InstanceManagerDialog QPushButton#createNew { qproperty-icon: url("./res+/instance_create.svg"); }
/* Delete instance */
#InstanceManagerDialog QPushButton#deleteInstance { qproperty-icon: url("./res+/instance_delete.svg"); }
/* Switch instance */
#InstanceManagerDialog QPushButton#switchToInstance { qproperty-icon: url("./res+/instance_switch.svg"); }
/* ==================== Modify executables ==================== */
/* Add executable */
#EditExecutablesDialog QToolButton#add { qproperty-icon: url("./res+/exec_add.svg"); }
/* Remove executable */
#EditExecutablesDialog QToolButton#remove { qproperty-icon: url("./res+/exec_remove.svg"); }
/* Move executable up */
#EditExecutablesDialog QToolButton#up { qproperty-icon: url("./res+/exec_up.svg"); }
/* Move executable down */
#EditExecutablesDialog QToolButton#down { qproperty-icon: url("./res+/exec_down.svg"); }
/* Reset executable list */
#EditExecutablesDialog QToolButton#reset { qproperty-icon: url("./res+/exec_reset.svg"); }
/* ==================== Settings / Nexus ==================== */
/* Disconnect from Nexus */
#SettingsDialog QPushButton#nexusDisconnect { qproperty-icon: url("./res+/nexus_disconnect.svg"); }
/* ==================== Mod info / Optional ESPs ==================== */
/* Activate ESP (right) */
#ModInfoDialog QToolButton#activateESP { qproperty-icon: url("./res+/esp_activate.svg"); }
/* Deactivate ESP (left) */
#ModInfoDialog QToolButton#deactivateESP { qproperty-icon: url("./res+/esp_deactivate.svg"); }
/* ==================== Mod info / Nexus ==================== */
/* Refresh mod information */
#ModInfoDialog QPushButton#refresh { qproperty-icon: url("./res+/nexus_info_refresh.svg"); }
/* Open Nexus / custom URL */
#ModInfoDialog QPushButton#visitNexus, #ModInfoDialog QPushButton#visitCustomURL { qproperty-icon: url("./res+/nexus_info_visit.svg"); }
/* Endorse mod */
#ModInfoDialog QPushButton#endorse { qproperty-icon: url("./res+/nexus_info_endorse.svg"); }
/* Track mod */
#ModInfoDialog QPushButton#track { qproperty-icon: url("./res+/nexus_info_track.svg"); }
/* ==================== Plugins ==================== */
/* Sort plugins */
#MainWindow QPushButton#sortButton { qproperty-icon: url("./res+/sort_plugins.svg"); }
/* ==================== Settings / Workarounds ==================== */
/* Back-date BSAs */
#SettingsDialog QPushButton#bsaDateBtn { qproperty-icon: url("./res+/backdate.svg"); }
/* ==================== View menu ==================== */
/* Show / hide Log */
QToolButton#actionViewLog { qproperty-icon: url("./res+/view_log.svg"); }
/* ==================== Top menu: Toolbars and Exit ==================== */
/* QMenu.icon controls the submenu entry; Exit uses MO2's named-action proxy. */
/* Toolbars submenu */
QMenu#menuToolbars { qproperty-icon: url("./res+/view_toolbars.svg"); }
/* Exit */
QToolButton#actionExit { qproperty-icon: url("./res+/file_exit.svg"); }
/* ==================== Nexus cache ==================== */
/* Clear Cache: broom icon. */
#SettingsDialog QPushButton#clearCacheButton { qproperty-icon: url("./res+/nexus_clear_cache.svg"); }
/* ====================       Tool plugins          ==================== */
/* Requires MO2 Icons Menu helper 1.1.0. Existing plugin icons are preserved. */
/* Requires plugins/mo2_icons_menu.py; actions are unnamed in stock MO2. */
/* ====================Tool plugins: shortcut menu ==================== */
/* Toolbar and Menu */
QToolButton#actionMO2IconsShortcutToolbar { qproperty-icon: url("./res+/link.svg"); }
/* Desktop */
QToolButton#actionMO2IconsShortcutDesktop { qproperty-icon: url("./res+/shortcut.svg"); }
/* Start Menu */
QToolButton#actionMO2IconsShortcutStartMenu { qproperty-icon: url("./res+/shortcut.svg"); }
/* ==================== Tool plugins: missing icons ==================== */
/* BSA Packer (missing icon) */
QToolButton#actionMO2IconsToolArchive { qproperty-icon: url("./res+/install_mod.svg"); }
/* Loot Paks (missing icon) */
QToolButton#actionMO2IconsToolSort { qproperty-icon: url("./res+/sort_plugins.svg"); }
/* Plugin Browser (missing icon) */
QToolButton#actionMO2IconsToolBrowse { qproperty-icon: url("./res+/tools_menu.svg"); }
/* Other tool plugins (missing icon) */
QToolButton#actionMO2IconsToolFallback { qproperty-icon: url("./res+/tools_menu.svg"); }
/* ==================== Tool plugins: icon bridges ==================== */
/* Download warning (no metadata) */
QToolButton#actionMO2IconsDownloadWarning { qproperty-icon: url("./res+/notifications.svg"); }
/* Mod Info: Nexus Info tab icon */
QToolButton#actionMO2IconsNexusTab { qproperty-icon: url("./res+/nexus_browser.svg"); }
