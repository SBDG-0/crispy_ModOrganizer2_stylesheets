/* Custom theme using VS15 Dark control styling.
   Based on VS15 Dark by chintsu_kun, holt59 and the MO2 Team, GPLv3.
   https://github.com/nikolay-borzov/modorganizer-themes
   Removed VS15 mod-list row padding, dialog minimum widths, field maximum
   widths, widget size constraints and outer margin/position adjustments.
   Internal control padding and subcontrol geometry retained for Qt painting.
*/
QListWidget::item { border-width: 0; }
#installLabel { color: none; }
QToolButton { border: none; }
QWidget { background-color: #1B2838; color: #DCDEDF; }
QWidget::disabled { color: #A6B4C2; }
* { outline: 0; }
*:disabled, QListView::item:disabled, *::item:selected:disabled { color: #A6B4C2; }
QTreeView, QListView, QTextEdit, QWebView, QTableView { border-style: solid; border-width: 1px; }
QAbstractItemView { color: #DCDEDF; background-color: #171D25; alternate-background-color: #1B2838; border-color: #536879; }
QAbstractItemView::item:selected, QAbstractItemView::item:selected:hover, QAbstractItemView::item:alternate:selected, QAbstractItemView::item:alternate:selected:hover { color: #DCDEDF; background-color: #315F80; }
QAbstractItemView[filtered=true] { border: 2px solid #f00; }
QAbstractItemView, QListView, QTreeView { show-decoration-selected: 1; }
QAbstractItemView::item:hover, QAbstractItemView::item:alternate:hover, QAbstractItemView::item:disabled:hover, QAbstractItemView::item:alternate:disabled:hover, QListView::item:hover, QTreeView::branch:hover, QTreeWidget::item:hover { background-color: #35566F; }
QAbstractItemView::item:selected:disabled, QAbstractItemView::item:alternate:selected:disabled, QListView::item:selected:disabled, QTreeView::branch:selected:disabled, QTreeWidget::item:selected:disabled { background-color: #35566F; }
QTreeView::branch:selected, #bsaList::branch:selected { background-color: #315F80; }
QLabel { background-color: transparent; }
LinkLabel { qproperty-linkColor: #315F80; }
QTreeView::branch:closed:has-children { image: url(./vs15/branch-closed.png); }
QTreeView::branch:open:has-children { image: url(./vs15/branch-open.png); }
QListView::item { color: #DCDEDF; }
QTextEdit, QWebView, QLineEdit, QAbstractSpinBox, QAbstractSpinBox::up-button, QAbstractSpinBox::down-button, QComboBox { background-color: #2A475E; border-color: #536879; }
QLineEdit:hover, QAbstractSpinBox:hover, QTextEdit:hover, QComboBox:hover, QComboBox:editable:hover { border-color: #315F80; }
QLineEdit:focus, QAbstractSpinBox::focus, QTextEdit:focus, QComboBox:focus, QComboBox:editable:focus, QComboBox:on { background-color: #536879; border-color: #315F80; }
QComboBox:on { border-bottom-color: #536879; }
QLineEdit, QAbstractSpinBox { padding: 2px; border-style: solid; border-width: 1px; }
QLineEdit QToolButton, QLineEdit QToolButton:hover { background: none; }
QComboBox { padding-left: 5px; border-style: solid; border-width: 1px; }
QComboBox:editable { padding-left: 3px; background-color: transparent; }
QComboBox::drop-down { width: 20px; subcontrol-origin: padding; subcontrol-position: top right; border: none; }
QComboBox::down-arrow { image: url(./vs15/combobox-down.png); }
QComboBox QAbstractItemView { background-color: #171D25; selection-background-color: #536879; border-color: #315F80; border-style: solid; border-width: 0 1px 1px 1px; }
QToolBar { border: none; }
QToolBar::separator { border-left-color: #171D25; border-right-color: #536879; border-width: 0 1px 0 1px; border-style: solid; width: 0; }
QToolButton { padding: 4px; }
QToolButton:hover { background-color: #35566F; }
QToolButton:pressed { background-color: #315F80; }
QToolButton::menu-indicator { image: url(./vs15/combobox-down.png); subcontrol-origin: padding; subcontrol-position: center right; padding-top: 10%; padding-right: 5%; }
QGroupBox { border-color: #536879; border-style: solid; border-width: 1px; padding: 1em 0.3em 0.3em 0.3em; margin-top: 0.65em; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 2px; }
QLCDNumber { border-color: #536879; border-style: solid; border-width: 1px; }
QPushButton { background-color: #2A475E; border-color: #536879; padding: 2px 5px; border-style: solid; border-width: 1px; }
QPushButton:hover, QPushButton:checked, QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #315F80; }
QPushButton:pressed, QPushButton:checked:hover, QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #315F80; }
QPushButton:disabled, QAbstractSpinBox::up-button:disabled, QAbstractSpinBox::down-button:disabled { background-color: #2A475E; border-color: #536879; }
QPushButton::menu-indicator { image: url(./vs15/combobox-down.png); subcontrol-origin: padding; subcontrol-position: center right; padding-right: 5%; }
QDialog QPushButton, QSlider::handle:horizontal, QSlider::handle:vertical { color: #DCDEDF; background-color: #2A475E; border-color: #536879; border-style: solid; border-width: 1px; }
QDialog QPushButton:hover, QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover, QSlider::handle:horizontal:pressed, QSlider::handle:horizontal:focus:pressed, QSlider::handle:vertical:pressed, QSlider::handle:vertical:focus:pressed { background-color: #35566F; border-color: #66C0F4; }
QSlider::handle:horizontal:focus, QSlider::handle:vertical:focus, QDialog QPushButton:checked { background-color: #2A475E; border-color: #315F80; }
QDialog QPushButton:focus { border-color: #315F80; }
QDialog QPushButton:disabled, QSlider::handle:horizontal:disabled, QSlider::handle:vertical:disabled { background-color: #2A475E; border-color: #536879; }
QDialog QPushButton { padding-left: 0.5em; padding-right: 0.5em; }
QGroupBox::indicator, QTreeView::indicator, QCheckBox::indicator, QRadioButton::indicator { background-color: #1B2838; border-color: #536879; width: 13px; height: 13px; border-style: solid; border-width: 1px; }
QGroupBox::indicator:hover, QTreeView::indicator:hover, QCheckBox::indicator:hover, QRadioButton::indicator:hover { background-color: #536879; border-color: #315F80; }
QGroupBox::indicator:checked, QTreeView::indicator:checked, QCheckBox::indicator:checked { image: url(./vs15/checkbox-check.png); }
QGroupBox::indicator:disabled, QTreeView::indicator:checked:disabled, QCheckBox::indicator:checked:disabled { image: url(./vs15/checkbox-check-disabled.png); }
QTreeView#modList::indicator { width: 15px; height: 15px; }
QRadioButton::indicator { border-radius: 7px; }
QRadioButton::indicator::checked { background-color: #66C0F4; border-width: 2px; width: 11px; height: 11px; }
QRadioButton::indicator::checked:hover { border-color: #536879; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border-style: solid; border-width: 1px; subcontrol-origin: padding; }
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::up-arrow { image: url(./vs15/spinner-up.png); }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::down-arrow { image: url(./vs15/spinner-down.png); }
QSlider::groove:horizontal { background-color: #536879; border: none; height: 8px; }
QSlider::handle:horizontal { width: 0.5em; height: 2em; margin: -7px 0; subcontrol-origin: margin; }
QAbstractScrollArea::corner { background-color: transparent; }
QScrollBar:horizontal { border: none; margin: 0 23px 0 23px; }
QScrollBar::handle:horizontal { min-width: 32px; margin: 4px 2px; }
QScrollBar::add-line:horizontal { width: 23px; subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::sub-line:horizontal { width: 23px; subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar:vertical { border: none; margin: 23px 0 23px 0; }
QScrollBar::handle:vertical { min-height: 32px; margin: 2px 4px; }
QScrollBar::add-line:vertical { height: 23px; subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-line:vertical { height: 23px; subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar { background-color: #35566F; border: none; }
QScrollBar::handle { background-color: #667D90; }
QScrollBar::add-line, QScrollBar::sub-line { background-color: #35566F; border: none; }
QScrollBar::handle:hover { background: #A6B4C2; }
QScrollBar::handle:pressed { background: #66C0F4; }
QScrollBar::handle:disabled { background: #536879; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::up-arrow:vertical { image: url(./vs15/scrollbar-up.png); }
QScrollBar::up-arrow:vertical:hover { image: url(./vs15/scrollbar-up-hover.png); }
QScrollBar::up-arrow:vertical:disabled { image: url(./vs15/scrollbar-up-disabled.png); }
QScrollBar::right-arrow:horizontal { image: url(./vs15/scrollbar-right.png); }
QScrollBar::right-arrow:horizontal:hover { image: url(./vs15/scrollbar-right-hover.png); }
QScrollBar::right-arrow:horizontal:disabled { image: url(./vs15/scrollbar-right-disabled.png); }
QScrollBar::down-arrow:vertical { image: url(./vs15/scrollbar-down.png); }
QScrollBar::down-arrow:vertical:hover { image: url(./vs15/scrollbar-down-hover.png); }
QScrollBar::down-arrow:vertical:disabled { image: url(./vs15/scrollbar-down-disabled.png); }
QScrollBar::left-arrow:horizontal { image: url(./vs15/scrollbar-left.png); }
QScrollBar::left-arrow:horizontal:hover { image: url(./vs15/scrollbar-left-hover.png); }
QScrollBar::left-arrow:horizontal:disabled { image: url(./vs15/scrollbar-left-disabled.png); }
QTableView { gridline-color: #536879; selection-background-color: #315F80; selection-color: #DCDEDF; }
QTableView QTableCornerButton::section { background: #2A475E; border-color: #536879; border-style: solid; border-width: 0 1px 1px 0; }
QHeaderView { border: none; }
QHeaderView::section { background: #2A475E; border-color: #536879; padding: 3px 5px; border-style: solid; border-width: 0 1px 1px 0; }
QHeaderView::section:hover { background: #35566F; color: #DCDEDF; }
QHeaderView::section:last { border-right: 0; }
QHeaderView::up-arrow { image: url(./vs15/sort-asc.png); }
QHeaderView::down-arrow { image: url(./vs15/sort-desc.png); }
QMenu { background-color: #171D25; border-color: #2A475E; border-style: solid; border-width: 1px; padding: 2px; }
QMenu::item { background: transparent; padding: 4px 20px; }
QMenu::item:selected, QMenuBar::item:selected { background-color: #35566F; }
QMenu::item:disabled { background-color: transparent; }
QMenu::separator { background-color: #2A475E; height: 1px; }
QMenu::right-arrow { image: url(./vs15/sub-menu-arrow.png); subcontrol-origin: padding; subcontrol-position: center right; padding-right: 0.5em; }
QMenu QPushButton { background-color: transparent; border-color: #536879; }
QMenu QCheckBox, QMenu QRadioButton { background-color: transparent; padding: 5px 2px; }
QToolTip, SaveGameInfoWidget { background-color: #2A475E; border-color: #536879; color: #DCDEDF; border-style: solid; border-width: 1px; padding: 2px; }
QStatusBar::item { border: None; }
QProgressBar { background-color: #171D25; color: #DCDEDF; border-color: #536879; text-align: center; border-style: solid; border-width: 1px; }
QProgressBar::chunk { background: #315F80; }
QTabWidget::pane { border-color: #536879; border-top-color: #315F80; border-style: solid; border-width: 1px; }
QTabWidget::pane:disabled { border-top-color: #536879; }
QTabBar::tab { background-color: transparent; padding: 4px 1em; border: none; }
QTabBar::tab:hover { background-color: #315F80; }
QTabBar::tab:selected, QTabBar::tab:selected:hover { background-color: #315F80; }
QTabBar::tab:disabled { background-color: transparent; color: #A6B4C2; }
QTabBar::tab:selected:disabled { background-color: #536879; }
QTabBar QToolButton { background-color: #2A475E; border-color: #536879; padding: 1px; border-style: solid; border-width: 1px; }
QTabBar QToolButton:hover { border-color: #315F80; border-width: 1px; border-style: solid; }
QTabBar QToolButton:disabled, QTabBar QToolButton:pressed:hover { background-color: #2A475E; }
QTabBar::scroller { width: 23px; background-color: #1B2838; }
QTabBar QToolButton::right-arrow { image: url(./vs15/scrollbar-right.png); }
QTabBar QToolButton::right-arrow:hover { image: url(./vs15/scrollbar-right-hover.png); }
QTabBar QToolButton::left-arrow { image: url(./vs15/scrollbar-left.png); }
QTabBar QToolButton::left-arrow:hover { image: url(./vs15/scrollbar-left-hover.png); }
QWidget#tabImages QPushButton { background-color: transparent; padding: 0; }
QWidget#tabESPs QToolButton { color: #DCDEDF; background-color: #2A475E; border-color: #536879; border-style: solid; border-width: 1px; }
QWidget#tabESPs QToolButton:hover { background-color: #35566F; border-color: #66C0F4; }
QWidget#tabESPs QToolButton:focus { border-color: #315F80; }
QWidget#tabESPs QToolButton:disabled { background-color: #2A475E; border-color: #536879; }
QTreeWidget#categoriesList::item { background-position: center left; background-repeat: no-repeat; }
QTreeWidget#categoriesList::item:has-children { background-image: url(./vs15/branch-closed.png); }
QTreeWidget#categoriesList::item:has-children:open { background-image: url(./vs15/branch-open.png); }
QDialog#PyCfgDialog QPushButton:hover { background-color: #35566F; }
QWidget#bsaTab QTreeWidget::indicator:unchecked { background-color: #315F80; }
QLineEdit[valid-filter=false] { background-color: #661111; }
QWidget { selection-background-color: #315F80; selection-color: #FFFFFF; }
LinkLabel { qproperty-linkColor: #66C0F4; }
QAbstractItemView { selection-background-color: #315F80; selection-color: #FFFFFF; }
QAbstractItemView::item:selected, QAbstractItemView::item:selected:hover, QAbstractItemView::item:alternate:selected, QAbstractItemView::item:alternate:selected:hover, QAbstractItemView::item:selected:!active, QListView::item:selected, QTreeWidget::item:selected, QTreeWidget::item:selected:hover { background-color: #315F80; color: #FFFFFF; }
QTreeView::branch:selected, QTreeView::branch:selected:hover, #bsaList::branch:selected { background-color: #315F80; }
QListView::item:selected:disabled, QTreeWidget::item:selected:disabled, QAbstractItemView::item:selected:disabled, QAbstractItemView::item:alternate:selected:disabled { background-color: #35566F; color: #A6B4C2; }
QComboBox QAbstractItemView { selection-background-color: #315F80; selection-color: #FFFFFF; }
QLineEdit:focus, QAbstractSpinBox:focus, QTextEdit:focus, QComboBox:focus, QComboBox:editable:focus, QComboBox:on { background-color: #2A475E; border-color: #66C0F4; }
QPushButton:hover, QPushButton:pressed, QPushButton:checked, QPushButton:checked:hover, QDialog QPushButton:hover, QDialog QPushButton:checked, QDialog#PyCfgDialog QPushButton:hover { background-color: #315F80; color: #FFFFFF; border-color: #66C0F4; }
QPushButton:focus, QDialog QPushButton:focus { border-color: #66C0F4; }
QDialog QPushButton:disabled, QPushButton:disabled { background-color: #2A475E; color: #A6B4C2; border-color: #536879; }
QToolButton:pressed, QToolButton:checked { background-color: #315F80; color: #FFFFFF; }
QWidget#tabESPs QToolButton:hover { background-color: #315F80; color: #FFFFFF; border-color: #66C0F4; }
QWidget#tabESPs QToolButton:focus { border-color: #66C0F4; }
QWidget#tabESPs QToolButton:disabled { color: #A6B4C2; }
QTabBar::tab:hover { background-color: #35566F; color: #DCDEDF; }
QTabBar::tab:selected, QTabBar::tab:selected:hover { background-color: #315F80; color: #FFFFFF; }
QTabBar::tab:selected:disabled { background-color: #536879; color: #DCDEDF; }
QMenu::item:selected, QMenuBar::item:selected { background-color: #315F80; color: #FFFFFF; }
QMenu::item:disabled { color: #A6B4C2; }
QToolTip, SaveGameInfoWidget { color: #DCDEDF; background-color: #2A475E; border-color: #66C0F4; }
QProgressBar { background-color: #171D25; color: #DCDEDF; }
QProgressBar::chunk { background-color: #315F80; }
QTableView { selection-color: #FFFFFF; }
QAbstractItemView[filtered="true"] { border: 2px solid #F2B65D; }
QLineEdit[valid-filter="false"] { background-color: #642E36; color: #FFFFFF; border-color: #F28B82; }
/* Centered menu icon gutter: preserve text padding and submenu arrows. */
QMenu::icon { position: relative; left: 12px; }
QMenu::indicator { position: relative; left: 12px; }
/* Keyboard focus uses an outline; persistent fills belong to hover, press and checked states. */
QPushButton:focus, QToolButton:focus { border-color: #66C0F4; }
