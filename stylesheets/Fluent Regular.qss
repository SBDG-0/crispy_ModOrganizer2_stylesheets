/* Custom theme using VS15 Dark control styling.
   Based on VS15 Dark by chintsu_kun, holt59 and the MO2 Team, GPLv3.
   https://github.com/nikolay-borzov/modorganizer-themes
   Removed VS15 mod-list row padding, dialog minimum widths, field maximum
   widths, widget size constraints and outer margin/position adjustments.
   Internal control padding and subcontrol geometry retained for Qt painting.
*/
QListWidget::item { border-width: 0; }
#installLabel { color: none; }
QToolButton { border: none; }
QWidget { background-color: #151b23; color: #f0f6fc; }
QWidget::disabled { color: #9198a1; }
* { outline: 0; }
*:disabled, QListView::item:disabled, *::item:selected:disabled { color: #9198a1; }
QTreeView, QListView, QTextEdit, QWebView, QTableView { border-style: solid; border-width: 1px; }
QAbstractItemView { color: #f0f6fc; background-color: #0d1117; alternate-background-color: #151b23; border-color: #3d444d; }
QAbstractItemView::item:selected, QAbstractItemView::item:selected:hover, QAbstractItemView::item:alternate:selected, QAbstractItemView::item:alternate:selected:hover { color: #f0f6fc; background-color: #1f4b7a; }
QAbstractItemView[filtered="true"] { border: 2px solid #f00; }
QAbstractItemView, QListView, QTreeView { show-decoration-selected: 1; }
QAbstractItemView::item:hover, QAbstractItemView::item:alternate:hover, QAbstractItemView::item:disabled:hover, QAbstractItemView::item:alternate:disabled:hover, QListView::item:hover, QTreeView::branch:hover, QTreeWidget::item:hover { background-color: #2a313c; }
QAbstractItemView::item:selected:disabled, QAbstractItemView::item:alternate:selected:disabled, QListView::item:selected:disabled, QTreeView::branch:selected:disabled, QTreeWidget::item:selected:disabled { background-color: #2a313c; }
QTreeView::branch:selected, #bsaList::branch:selected { background-color: #1f4b7a; }
QLabel { background-color: transparent; }
LinkLabel { qproperty-linkColor: #1f4b7a; }
QTreeView::branch:closed:has-children { image: url(./vs15/branch-closed.png); }
QTreeView::branch:open:has-children { image: url(./vs15/branch-open.png); }
QListView::item { color: #f0f6fc; }
QTextEdit, QWebView, QLineEdit, QAbstractSpinBox, QAbstractSpinBox::up-button, QAbstractSpinBox::down-button, QComboBox { background-color: #212830; border-color: #3d444d; }
QLineEdit:hover, QAbstractSpinBox:hover, QTextEdit:hover, QComboBox:hover, QComboBox:editable:hover { border-color: #1f4b7a; }
QLineEdit:focus, QAbstractSpinBox::focus, QTextEdit:focus, QComboBox:focus, QComboBox:editable:focus, QComboBox:on { background-color: #3d444d; border-color: #1f4b7a; }
QComboBox:on { border-bottom-color: #3d444d; }
QLineEdit, QAbstractSpinBox { padding: 2px; border-style: solid; border-width: 1px; }
QLineEdit QToolButton, QLineEdit QToolButton:hover { background: none; }
QComboBox { padding-left: 5px; border-style: solid; border-width: 1px; }
QComboBox:editable { padding-left: 3px; background-color: transparent; }
QComboBox::drop-down { width: 20px; subcontrol-origin: padding; subcontrol-position: top right; border: none; }
QComboBox::down-arrow { image: url(./vs15/combobox-down.png); }
QComboBox QAbstractItemView { background-color: #0d1117; selection-background-color: #3d444d; border-color: #1f4b7a; border-style: solid; border-width: 0 1px 1px 1px; }
QToolBar { border: none; }
QToolBar::separator { border-left-color: #0d1117; border-right-color: #3d444d; border-width: 0 1px 0 1px; border-style: solid; width: 0; }
QToolButton { padding: 4px; }
QToolButton:hover { background-color: #2a313c; }
QToolButton:pressed { background-color: #1f4b7a; }
QToolButton::menu-indicator { image: url(./vs15/combobox-down.png); subcontrol-origin: padding; subcontrol-position: center right; padding-top: 10%; padding-right: 5%; }
QGroupBox { border-color: #3d444d; border-style: solid; border-width: 1px; padding: 1em 0.3em 0.3em 0.3em; margin-top: 0.65em; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 2px; }
QLCDNumber { border-color: #3d444d; border-style: solid; border-width: 1px; }
QPushButton { background-color: #212830; border-color: #3d444d; padding: 2px 5px; border-style: solid; border-width: 1px; }
QPushButton:hover, QPushButton:checked, QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #1f4b7a; }
QPushButton:pressed, QPushButton:checked:hover, QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #1f4b7a; }
QPushButton:disabled, QAbstractSpinBox::up-button:disabled, QAbstractSpinBox::down-button:disabled { background-color: #212830; border-color: #3d444d; }
QPushButton::menu-indicator { image: url(./vs15/combobox-down.png); subcontrol-origin: padding; subcontrol-position: center right; padding-right: 5%; }
QDialog QPushButton, QSlider::handle:horizontal, QSlider::handle:vertical { color: #f0f6fc; background-color: #212830; border-color: #3d444d; border-style: solid; border-width: 1px; }
QDialog QPushButton:hover, QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover, QSlider::handle:horizontal:pressed, QSlider::handle:horizontal:focus:pressed, QSlider::handle:vertical:pressed, QSlider::handle:vertical:focus:pressed { background-color: #2a313c; border-color: #4493f8; }
QSlider::handle:horizontal:focus, QSlider::handle:vertical:focus, QDialog QPushButton:checked { background-color: #212830; border-color: #1f4b7a; }
QDialog QPushButton:focus { border-color: #1f4b7a; }
QDialog QPushButton:disabled, QSlider::handle:horizontal:disabled, QSlider::handle:vertical:disabled { background-color: #212830; border-color: #3d444d; }
QDialog QPushButton { padding-left: 0.5em; padding-right: 0.5em; }
QGroupBox::indicator, QTreeView::indicator, QCheckBox::indicator, QRadioButton::indicator { background-color: #151b23; border-color: #3d444d; width: 13px; height: 13px; border-style: solid; border-width: 1px; }
QGroupBox::indicator:hover, QTreeView::indicator:hover, QCheckBox::indicator:hover, QRadioButton::indicator:hover { background-color: #3d444d; border-color: #1f4b7a; }
QGroupBox::indicator:checked, QTreeView::indicator:checked, QCheckBox::indicator:checked { image: url(./vs15/checkbox-check.png); }
QGroupBox::indicator:disabled, QTreeView::indicator:checked:disabled, QCheckBox::indicator:checked:disabled { image: url(./vs15/checkbox-check-disabled.png); }
QTreeView#modList::indicator { width: 15px; height: 15px; }
QRadioButton::indicator { border-radius: 7px; }
QRadioButton::indicator::checked { background-color: #4493f8; border-width: 2px; width: 11px; height: 11px; }
QRadioButton::indicator::checked:hover { border-color: #3d444d; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border-style: solid; border-width: 1px; subcontrol-origin: padding; }
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::up-arrow { image: url(./vs15/spinner-up.png); }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::down-arrow { image: url(./vs15/spinner-down.png); }
QSlider::groove:horizontal { background-color: #3d444d; border: none; height: 8px; }
QSlider::handle:horizontal { width: 0.5em; height: 2em; margin: -7px 0; subcontrol-origin: margin; }
QAbstractScrollArea::corner { background-color: transparent; }
QScrollBar:horizontal { border: none; margin: 0 23px 0 23px; }
QScrollBar::handle:horizontal { min-width: 32px; margin: 4px 2px; }
QScrollBar::add-line:horizontal { width: 23px; subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::sub-line:horizontal { width: 23px; subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar:vertical { border: none; margin: 23px 0 23px 0; }
QScrollBar::handle:vertical { min-height: 32px; margin: 2px 4px; }
QScrollBar::add-line:vertical { height: 23px; subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-line:vertical { height: 23px; subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar { background-color: #2a313c; border: none; }
QScrollBar::handle { background-color: #596574; }
QScrollBar::add-line, QScrollBar::sub-line { background-color: #2a313c; border: none; }
QScrollBar::handle:hover { background: #9198a1; }
QScrollBar::handle:pressed { background: #4493f8; }
QScrollBar::handle:disabled { background: #3d444d; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::up-arrow:vertical { image: url(./vs15/scrollbar-up.png); }
QScrollBar::up-arrow:vertical:hover { image: url(./vs15/scrollbar-up-hover.png); }
QScrollBar::up-arrow:vertical:disabled { image: url(./vs15/scrollbar-up-disabled.png); }
QScrollBar::right-arrow:horizontal { image: url(./vs15/scrollbar-right.png); }
QScrollBar::right-arrow:horizontal:hover { image: url(./vs15/scrollbar-right-hover.png); }
QScrollBar::right-arrow:horizontal:disabled { image: url(./vs15/scrollbar-right-disabled.png); }
QScrollBar::down-arrow:vertical { image: url(./vs15/scrollbar-down.png); }
QScrollBar::down-arrow:vertical:hover { image: url(./vs15/scrollbar-down-hover.png); }
QScrollBar::down-arrow:vertical:disabled { image: url(./vs15/scrollbar-down-disabled.png); }
QScrollBar::left-arrow:horizontal { image: url(./vs15/scrollbar-left.png); }
QScrollBar::left-arrow:horizontal:hover { image: url(./vs15/scrollbar-left-hover.png); }
QScrollBar::left-arrow:horizontal:disabled { image: url(./vs15/scrollbar-left-disabled.png); }
QTableView { gridline-color: #3d444d; selection-background-color: #1f4b7a; selection-color: #f0f6fc; }
QTableView QTableCornerButton::section { background: #212830; border-color: #3d444d; border-style: solid; border-width: 0 1px 1px 0; }
QHeaderView { border: none; }
QHeaderView::section { background: #212830; border-color: #3d444d; padding: 3px 5px; border-style: solid; border-width: 0 1px 1px 0; }
QHeaderView::section:hover { background: #2a313c; color: #f0f6fc; }
QHeaderView::section:last { border-right: 0; }
QHeaderView::up-arrow { image: url(./vs15/sort-asc.png); }
QHeaderView::down-arrow { image: url(./vs15/sort-desc.png); }
QMenu { background-color: #0d1117; border-color: #212830; border-style: solid; border-width: 1px; padding: 2px; }
QMenu::item { background: transparent; padding: 4px 20px; }
QMenu::item:selected, QMenuBar::item:selected { background-color: #2a313c; }
QMenu::item:disabled { background-color: transparent; }
QMenu::separator { background-color: #212830; height: 1px; }
QMenu::right-arrow { image: url(./vs15/sub-menu-arrow.png); subcontrol-origin: padding; subcontrol-position: center right; padding-right: 0.5em; }
QMenu QPushButton { background-color: transparent; border-color: #3d444d; }
QMenu QCheckBox, QMenu QRadioButton { background-color: transparent; padding: 5px 2px; }
QToolTip, SaveGameInfoWidget { background-color: #212830; border-color: #3d444d; color: #f0f6fc; border-style: solid; border-width: 1px; padding: 2px; }
QStatusBar::item { border: None; }
QProgressBar { background-color: #0d1117; color: #f0f6fc; border-color: #3d444d; text-align: center; border-style: solid; border-width: 1px; }
QProgressBar::chunk { background: #1f4b7a; }
QTabWidget::pane { border-color: #3d444d; border-top-color: #1f4b7a; border-style: solid; border-width: 1px; }
QTabWidget::pane:disabled { border-top-color: #3d444d; }
QTabBar::tab { background-color: transparent; padding: 4px 1em; border: none; }
QTabBar::tab:hover { background-color: #1f4b7a; }
QTabBar::tab:selected, QTabBar::tab:selected:hover { background-color: #1f4b7a; }
QTabBar::tab:disabled { background-color: transparent; color: #9198a1; }
QTabBar::tab:selected:disabled { background-color: #3d444d; }
QTabBar QToolButton { background-color: #212830; border-color: #3d444d; padding: 1px; border-style: solid; border-width: 1px; }
QTabBar QToolButton:hover { border-color: #1f4b7a; border-width: 1px; border-style: solid; }
QTabBar QToolButton:disabled, QTabBar QToolButton:pressed:hover { background-color: #212830; }
QTabBar::scroller { width: 23px; background-color: #151b23; }
QTabBar QToolButton::right-arrow { image: url(./vs15/scrollbar-right.png); }
QTabBar QToolButton::right-arrow:hover { image: url(./vs15/scrollbar-right-hover.png); }
QTabBar QToolButton::left-arrow { image: url(./vs15/scrollbar-left.png); }
QTabBar QToolButton::left-arrow:hover { image: url(./vs15/scrollbar-left-hover.png); }
QWidget#tabImages QPushButton { background-color: transparent; padding: 0; }
QWidget#tabESPs QToolButton { color: #f0f6fc; background-color: #212830; border-color: #3d444d; border-style: solid; border-width: 1px; }
QWidget#tabESPs QToolButton:hover { background-color: #2a313c; border-color: #4493f8; }
QWidget#tabESPs QToolButton:focus { border-color: #1f4b7a; }
QWidget#tabESPs QToolButton:disabled { background-color: #212830; border-color: #3d444d; }
QTreeWidget#categoriesList::item { background-position: center left; background-repeat: no-repeat; }
QTreeWidget#categoriesList::item:has-children { background-image: url(./vs15/branch-closed.png); }
QTreeWidget#categoriesList::item:has-children:open { background-image: url(./vs15/branch-open.png); }
QDialog#PyCfgDialog QPushButton:hover { background-color: #2a313c; }
QWidget#bsaTab QTreeWidget::indicator:unchecked { background-color: #1f4b7a; }
QLineEdit[valid-filter="false"] { background-color: #661111; }
QWidget { selection-background-color: #1f4b7a; selection-color: #ffffff; }
LinkLabel { qproperty-linkColor: #4493f8; }
QAbstractItemView { selection-background-color: #1f4b7a; selection-color: #ffffff; }
QAbstractItemView::item:selected, QAbstractItemView::item:selected:hover, QAbstractItemView::item:alternate:selected, QAbstractItemView::item:alternate:selected:hover, QAbstractItemView::item:selected:!active, QListView::item:selected, QTreeWidget::item:selected, QTreeWidget::item:selected:hover { background-color: #1f4b7a; color: #ffffff; }
QTreeView::branch:selected, QTreeView::branch:selected:hover, #bsaList::branch:selected { background-color: #1f4b7a; }
QListView::item:selected:disabled, QTreeWidget::item:selected:disabled, QAbstractItemView::item:selected:disabled, QAbstractItemView::item:alternate:selected:disabled { background-color: #2a313c; color: #9198a1; }
QComboBox QAbstractItemView { selection-background-color: #1f4b7a; selection-color: #ffffff; }
QLineEdit:focus, QAbstractSpinBox:focus, QTextEdit:focus, QComboBox:focus, QComboBox:editable:focus, QComboBox:on { background-color: #212830; border-color: #4493f8; }
QPushButton:hover, QPushButton:pressed, QPushButton:checked, QPushButton:checked:hover, QDialog QPushButton:hover, QDialog QPushButton:checked, QDialog#PyCfgDialog QPushButton:hover { background-color: #1f4b7a; color: #ffffff; border-color: #4493f8; }
QPushButton:focus, QDialog QPushButton:focus { border-color: #4493f8; }
QDialog QPushButton:disabled, QPushButton:disabled { background-color: #212830; color: #9198a1; border-color: #3d444d; }
QToolButton:pressed, QToolButton:checked { background-color: #1f4b7a; color: #ffffff; }
QWidget#tabESPs QToolButton:hover { background-color: #1f4b7a; color: #ffffff; border-color: #4493f8; }
QWidget#tabESPs QToolButton:focus { border-color: #4493f8; }
QWidget#tabESPs QToolButton:disabled { color: #9198a1; }
QTabBar::tab:hover { background-color: #2a313c; color: #f0f6fc; }
QTabBar::tab:selected, QTabBar::tab:selected:hover { background-color: #1f4b7a; color: #ffffff; }
QTabBar::tab:selected:disabled { background-color: #3d444d; color: #f0f6fc; }
QMenu::item:selected, QMenuBar::item:selected { background-color: #1f4b7a; color: #ffffff; }
QMenu::item:disabled { color: #9198a1; }
QToolTip, SaveGameInfoWidget { color: #f0f6fc; background-color: #212830; border-color: #4493f8; }
QProgressBar { background-color: #0d1117; color: #f0f6fc; }
QProgressBar::chunk { background-color: #1f4b7a; }
QTableView { selection-color: #ffffff; }
QAbstractItemView[filtered="true"] { border: 2px solid #f2b65d; }
QLineEdit[valid-filter="false"] { background-color: #642e36; color: #ffffff; border-color: #f28b82; }
/* Centered menu icon gutter: preserve text padding and submenu arrows. */
QMenu::icon { position: relative; left: 12px; }
QMenu::indicator { position: relative; left: 12px; }
/* Keyboard focus uses an outline; persistent fills belong to hover, press and checked states. */
QPushButton:focus, QToolButton:focus { border-color: #4493f8; }




/* Fluent Regular: pale icons for dark themes.
   Copy any complete section below AFTER your base theme.
   Keep mo2-icon-test-assets beside the destination stylesheet.
   Icon-only overrides; toolbar selectors must remain unscoped. */
/* ==================== Toolbar ==================== */
/* Change game / instance */
QToolButton#actionChange_Game { qproperty-icon: url("./res+/change_game.svg"); }
/* Install mod archive */
QToolButton#actionInstallMod { qproperty-icon: url("./res+/install_mod.svg"); }
/* Nexus / game mod page */
QToolButton#actionNexus, QToolButton#actionModPage { qproperty-icon: url("./res+/nexus_browser.svg"); }
/* Configure profiles */
QToolButton#actionAdd_Profile { qproperty-icon: url("./res+/profiles.svg"); }
/* Refresh MO2 */
QToolButton#action_Refresh { qproperty-icon: url("./res+/refresh_main.svg"); }
/* Modify executables */
QToolButton#actionModify_Executables { qproperty-icon: url("./res+/executables.svg"); }
/* Tool plugins */
QToolButton#actionTool { qproperty-icon: url("./res+/tools_menu.svg"); }
/* Settings */
QToolButton#actionSettings { qproperty-icon: url("./res+/settings.svg"); }
/* Endorse MO2 */
QToolButton#actionEndorseMO { qproperty-icon: url("./res+/endorse_mo.svg"); }
/* Notifications / problems */
QToolButton#actionNotifications { qproperty-icon: url("./res+/notifications.svg"); }
/* Check for updates */
QToolButton#actionUpdate { qproperty-icon: url("./res+/update_mo.svg"); }
/* Help / tutorials */
QToolButton#actionHelp { qproperty-icon: url("./res+/help_menu.svg"); }
/* ==================== Mod list ==================== */
/* List options */
#MainWindow QPushButton#listOptionsBtn { qproperty-icon: url("./res+/list_options.svg"); }
/* Open folders menu */
#MainWindow QPushButton#openFolderMenu { qproperty-icon: url("./res+/open_folder.svg"); }
/* Clear all filters */
#MainWindow QPushButton#clearFiltersButton { qproperty-icon: url("./res+/clear_filters.svg"); }
/* ==================== Mod / plugin lists ==================== */
/* Restore backup */
#MainWindow QPushButton#restoreModsButton, #MainWindow QPushButton#restoreButton { qproperty-icon: url("./res+/restore_backup.svg"); }
/* Create backup */
#MainWindow QPushButton#saveModsButton, #MainWindow QPushButton#saveButton { qproperty-icon: url("./res+/create_backup.svg"); }
/* ==================== Right pane ==================== */
/* Run executable */
#MainWindow QPushButton#startButton { qproperty-icon: url("./res+/run_start.svg"); }
/* Create shortcut */
#MainWindow QPushButton#linkButton { qproperty-icon: url("./res+/shortcut_link.svg"); }
/* ==================== Data / Downloads ==================== */
/* Refresh data / downloads */
#MainWindow QPushButton#dataTabRefresh, #MainWindow QPushButton#btnRefreshDownloads { qproperty-icon: url("./res+/refresh_data.svg"); }
/* ==================== Instance manager ==================== */
/* Create instance */
#InstanceManagerDialog QPushButton#createNew { qproperty-icon: url("./res+/instance_create.svg"); }
/* Delete instance */
#InstanceManagerDialog QPushButton#deleteInstance { qproperty-icon: url("./res+/instance_delete.svg"); }
/* Switch instance */
#InstanceManagerDialog QPushButton#switchToInstance { qproperty-icon: url("./res+/instance_switch.svg"); }
/* ==================== Modify executables ==================== */
/* Add executable */
#EditExecutablesDialog QToolButton#add { qproperty-icon: url("./res+/exec_add.svg"); }
/* Remove executable */
#EditExecutablesDialog QToolButton#remove { qproperty-icon: url("./res+/exec_remove.svg"); }
/* Move executable up */
#EditExecutablesDialog QToolButton#up { qproperty-icon: url("./res+/exec_up.svg"); }
/* Move executable down */
#EditExecutablesDialog QToolButton#down { qproperty-icon: url("./res+/exec_down.svg"); }
/* Reset executable list */
#EditExecutablesDialog QToolButton#reset { qproperty-icon: url("./res+/exec_reset.svg"); }
/* ==================== Settings / Nexus ==================== */
/* Disconnect from Nexus */
#SettingsDialog QPushButton#nexusDisconnect { qproperty-icon: url("./res+/nexus_disconnect.svg"); }
/* ==================== Mod info / Optional ESPs ==================== */
/* Activate ESP (right) */
#ModInfoDialog QToolButton#activateESP { qproperty-icon: url("./res+/esp_activate.svg"); }
/* Deactivate ESP (left) */
#ModInfoDialog QToolButton#deactivateESP { qproperty-icon: url("./res+/esp_deactivate.svg"); }
/* ==================== Mod info / Nexus ==================== */
/* Refresh mod information */
#ModInfoDialog QPushButton#refresh { qproperty-icon: url("./res+/nexus_info_refresh.svg"); }
/* Open Nexus / custom URL */
#ModInfoDialog QPushButton#visitNexus, #ModInfoDialog QPushButton#visitCustomURL { qproperty-icon: url("./res+/nexus_info_visit.svg"); }
/* Endorse mod */
#ModInfoDialog QPushButton#endorse { qproperty-icon: url("./res+/nexus_info_endorse.svg"); }
/* Track mod */
#ModInfoDialog QPushButton#track { qproperty-icon: url("./res+/nexus_info_track.svg"); }
/* ==================== Plugins ==================== */
/* Sort plugins */
#MainWindow QPushButton#sortButton { qproperty-icon: url("./res+/sort_plugins.svg"); }
/* ==================== Settings / Workarounds ==================== */
/* Back-date BSAs */
#SettingsDialog QPushButton#bsaDateBtn { qproperty-icon: url("./res+/backdate.svg"); }
/* ==================== View menu ==================== */
/* Show / hide Log */
QToolButton#actionViewLog { qproperty-icon: url("./res+/view_log.svg"); }
/* ==================== Top menu: Toolbars and Exit ==================== */
/* QMenu.icon controls the submenu entry; Exit uses MO2's named-action proxy. */
/* Toolbars submenu */
QMenu#menuToolbars { qproperty-icon: url("./res+/view_toolbars.svg"); }
/* Exit */
QToolButton#actionExit { qproperty-icon: url("./res+/file_exit.svg"); }
/* ==================== Nexus cache ==================== */
/* Clear Cache: broom icon. */
#SettingsDialog QPushButton#clearCacheButton { qproperty-icon: url("./res+/nexus_clear_cache.svg"); }
/* ==================== Shortcut menu ==================== */
/* Requires plugins/mo2_icons_menu.py; actions are unnamed in stock MO2. */
/* Toolbar and Menu */
QToolButton#actionMO2IconsShortcutToolbar { qproperty-icon: url("./res+/shortcut_link.svg"); }
/* Desktop */
QToolButton#actionMO2IconsShortcutDesktop { qproperty-icon: url("./res+/shortcut_link.svg"); }
/* Start Menu */
QToolButton#actionMO2IconsShortcutStartMenu { qproperty-icon: url("./res+/shortcut_link.svg"); }
/* ==================== Tool plugins: missing icons ==================== */
/* Requires MO2 Icons Menu helper 1.1.0. Existing plugin icons are preserved. */
/* BSA Packer (missing icon) */
QToolButton#actionMO2IconsToolArchive { qproperty-icon: url("./res+/install_mod.svg"); }
/* Loot Paks (missing icon) */
QToolButton#actionMO2IconsToolSort { qproperty-icon: url("./res+/sort_plugins.svg"); }
/* Plugin Browser (missing icon) */
QToolButton#actionMO2IconsToolBrowse { qproperty-icon: url("./res+/tools_menu.svg"); }
/* Other tool plugins (missing icon) */
QToolButton#actionMO2IconsToolFallback { qproperty-icon: url("./res+/tools_menu.svg"); }
/* ==================== Tool plugins: icon bridges ==================== */
/* Download warning (no metadata) */
QToolButton#actionMO2IconsDownloadWarning { qproperty-icon: url("./res+/download_warning.svg"); }
/* Mod Info: Nexus Info tab icon */
QToolButton#actionMO2IconsNexusTab { qproperty-icon: url("./res+/nexus_browser.svg"); }
