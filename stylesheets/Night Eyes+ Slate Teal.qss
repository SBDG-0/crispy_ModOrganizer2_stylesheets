/* Tables (Configure Mod Categories) ------------------------------------------ */
QTableView { gridline-color: #252C35; border: 0px; }
QListWidget::item#executablesListBox { /* fixes the black text problem on the Modify Executables window */ color: #E8EEF4; }
/* Downloads tab -------------------------------------------------------------- */
QWidget#downloadTab QAbstractScrollArea { /* background of the entire downloads tab */ background: #1B222B; }
DownloadListView QFrame { /* an entry on the Downloads tab */ background: #252C35; }
DownloadListView QFrame#frame { /* outer box of an entry on the Downloads tab */ border: 2px solid #1B222B; }
DownloadListView QLabel#installLabel { color: #E8EEF4; }
DownloadListView QFrame:clicked { background: #3B4B59; }
/* compact downloads view */
DownloadListView[downloadView=standard]::item { padding: 16px; }
DownloadListView[downloadView=compact]::item { padding: 4px; }
DownloadListView::item:hover { padding: 0px; }
DownloadListView::item:selected { padding: 0px; }
QProgressBar { border: 2px solid #5D7182; border-radius: 5px; text-align: center; margin: 0px; }
QAbstractItemView[filtered=true] { border: 2px solid #f00; }
QLineEdit[valid-filter=false] { background-color: #661111; }
/* Readability refinements. Derived from Night Eyes by Ciathyza.
   Variant: Slate Teal. Original theme: https://github.com/ciathyza/mo2-themes
   Native title bars and MO2 per-mod/conflict colors are separate settings. */
QWidget { selection-background-color: #285D65; selection-color: #FFFFFF; }
QAbstractItemView { alternate-background-color: #252C35; }
QAbstractItemView::item:hover, QTreeView::item:hover, QListView::item:hover { background: #3B4B59; color: #E8EEF4; }
QAbstractItemView::item:selected, QTreeView::item:selected, QListView::item:selected, QTreeView::branch:selected { background: #285D65; color: #FFFFFF; }
QAbstractItemView::item:selected:!active, QTreeView::item:selected:!active, QListView::item:selected:!active, QTreeView::branch:selected:!active { background: #285D65; color: #FFFFFF; }
QGroupBox { border-color: #5D7182; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #1B222B; color: #E8EEF4; border: 1px solid #5D7182; border-radius: 5px; selection-background-color: #285D65; selection-color: #FFFFFF; }
QSpinBox, QDoubleSpinBox { min-height: 20px; padding: 2px 4px; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #A7B6C5; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #75D5C4; }
QTextEdit, QPlainTextEdit { background: #1B222B; color: #E8EEF4; border: 1px solid #5D7182; }
QPushButton { background: #303B47; color: #E8EEF4; border: 1px solid #5D7182; }
QPushButton:hover, QToolButton:hover { background: #3B4B59; color: #E8EEF4; }
QPushButton:pressed, QPushButton:checked, QToolButton:pressed, QToolButton:checked { background: #285D65; color: #FFFFFF; }
QPushButton:checked { margin: 0px; }
QPushButton:focus, QToolButton:focus, QPushButton:default { border: 1px solid #75D5C4; }
QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: #252C35; color: #A7B6C5; border-color: #5D7182; }
QHeaderView::section { background: #303B47; color: #E8EEF4; border-bottom: 1px solid #5D7182; border-right: 1px solid #5D7182; }
QHeaderView::section:hover { background: #3B4B59; color: #75D5C4; }
QTabWidget::pane { border-color: #5D7182; }
QTabBar::tab { background: #1B222B; color: #E8EEF4; border: 1px solid #5D7182; border-bottom: 2px solid #5D7182; }
QTabBar::tab:selected { background: #303B47; color: #75D5C4; border-bottom: 2px solid #75D5C4; }
QTabBar::tab:!selected:hover { background: #3B4B59; color: #E8EEF4; }
QTabBar::tab:disabled { background: #252C35; color: #A7B6C5; }
QMenu { background: #303B47; color: #E8EEF4; border: 1px solid #5D7182; }
QMenu::item { background: transparent; color: #E8EEF4; }
QMenu::item:selected, QMenuBar::item:selected { background: #285D65; color: #FFFFFF; }
QMenu::item:disabled { background: transparent; color: #A7B6C5; }
QMenu::separator { background: #5D7182; height: 1px; margin: 3px 8px; }
QToolTip { background: #303B47; color: #E8EEF4; border: 1px solid #75D5C4; padding: 5px; }
QScrollBar::handle:horizontal, QScrollBar::handle:vertical { background: #6A8494; }
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover { background: #A7B6C5; }
QScrollBar::handle:horizontal:pressed, QScrollBar::handle:vertical:pressed { background: #75D5C4; }
QProgressBar { background: #1B222B; color: #E8EEF4; border: 1px solid #5D7182; }
QProgressBar::chunk { background: #285D65; }
QTableView { gridline-color: #5D7182; }
QCheckBox, QRadioButton { spacing: 5px; }
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled { color: #A7B6C5; }
QCheckBox::indicator:unchecked { background: #1B222B; border: 1px solid #A7B6C5; border-radius: 2px; }
QCheckBox::indicator:unchecked:hover { border-color: #75D5C4; background: #3B4B59; }
QCheckBox::indicator:checked:hover { border: 1px solid #75D5C4; }
QCheckBox::indicator:unchecked:disabled { border-color: #5D7182; background: #252C35; }
QSplitter::handle { background: #5D7182; }
QSplitter::handle:hover { background: #75D5C4; }
QAbstractItemView[filtered="true"] { border: 2px solid #F2B65D; }
QLineEdit[valid-filter="false"] { background: #642E36; color: #FFFFFF; border: 1px solid #F28B82; }
/* Centered menu icon gutter: preserve text padding and submenu arrows. */
QMenu::icon { position: relative; left: 11px; }
QMenu::indicator { position: relative; left: 12px; }
